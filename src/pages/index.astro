---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import WorkTile from '../components/WorkTile.astro';
import Footer from '../components/Footer.astro';
import SkillList from '../components/SkillList.astro';
import {
  site,
  profile,
  works,
  levels,
  timeline,
} from '../data/profile';

const levelKeys = Object.keys(levels).map(Number) as (keyof typeof levels)[];
---

<Base
  title={`${profile.nameEn} | ${site.title}`}
  description={`${profile.school} ${profile.grade} のポートフォリオ`}
>
  <Header />

  <main id="top">
    <!-- ===== Hero (黒面) ===== -->
    <section class="hero">
      <div class="container">
        <p class="hero-kicker en">Portfolio — v{site.version}</p>
        <h1 class="hero-name">{profile.name}</h1>
        <p class="hero-tagline">{profile.tagline}</p>
        <dl class="hero-meta">
          <div>
            <dt class="en">School</dt>
            <dd>{profile.school}</dd>
          </div>
          <div>
            <dt class="en">Grade</dt>
            <dd>{profile.grade}</dd>
          </div>
        </dl>
        <p class="hero-updated en">Updated {site.updated}</p>
      </div>
    </section>

    <!-- ===== About ===== -->
    <section class="section" id="about">
      <div class="container">
        <div class="section-head">
          <span class="section-num">01</span>
          <p class="section-sub en">About</p>
          <h2 class="section-title">プロフィール</h2>
        </div>
        <div class="about">
          <div class="about-text">
            {profile.about.map((p) => <p>{p}</p>)}
          </div>
          <div class="about-side">
            <h3 class="side-title en">Interests / 興味・得意なこと</h3>
            <ul class="tags">
              {profile.interests.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Works ===== -->
    <section class="section section-works" id="works">
      <div class="container">
        <div class="section-head">
          <span class="section-num">02</span>
          <p class="section-sub en">Works</p>
          <h2 class="section-title">制作物</h2>
          <p class="section-lead">カードを選ぶと、作品の詳細ページを表示します。</p>
        </div>
        <ul class="works-grid">
          {works.map((w, i) => <li><WorkTile work={w} index={i} /></li>)}
        </ul>
      </div>
    </section>

    <!-- ===== Skills ===== -->
    <section class="section" id="skills">
      <div class="container">
        <div class="section-head">
          <span class="section-num">03</span>
          <p class="section-sub en">Skills</p>
          <h2 class="section-title">スキル・経験</h2>
          <p class="section-lead">
            使用経験を3段階で示しています。実際に作ったものは、上の「制作物」で紹介しています。
          </p>
        </div>

        <dl class="legend">
          {
            levelKeys.map((k) => (
              <div class="legend-item">
                <dt>
                  <span class="lv">
                    <span class="lv-dots" aria-hidden="true">
                      {[1, 2, 3].map((d) => (
                        <span class:list={['dot', { on: d <= k }]} />
                      ))}
                    </span>
                    Lv.{k} {levels[k].name}
                  </span>
                </dt>
                <dd>{levels[k].desc}</dd>
              </div>
            ))
          }
        </dl>

        <SkillList />
      </div>
    </section>

    <!-- ===== History ===== -->
    <section class="section" id="history">
      <div class="container">
        <div class="section-head">
          <span class="section-num">04</span>
          <p class="section-sub en">History</p>
          <h2 class="section-title">経歴・活動</h2>
        </div>
        <ol class="timeline">
          {
            timeline.map((e) => (
              <li>
                <time>{e.date}</time>
                <div>
                  <p class="tl-title">{e.title}</p>
                  {e.desc && <p class="tl-desc">{e.desc}</p>}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---------- Hero: 画面いっぱいの暗い面に、細い文字で名前を置く ---------- */
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    padding-block: 96px;
    background: var(--bg);
  }
  .hero-kicker {
    font-size: 12px;
    color: var(--mist);
  }
  .hero-name {
    font-size: clamp(32px, 6vw, 64px);
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: 0.1em;
    margin-top: 24px;
  }
  .hero-tagline {
    font-size: clamp(20px, 2.6vw, 31.5px);
    font-weight: 300;
    line-height: 2;
    letter-spacing: 0.1em;
    margin-top: 32px;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 48px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line-soft);
  }
  .hero-meta dt {
    font-size: 11px;
    color: var(--mist);
  }
  .hero-meta dd {
    margin: 4px 0 0;
    font-size: 15px;
  }
  .hero-updated {
    margin-top: 40px;
    font-size: 11px;
    color: var(--mist);
  }

  /* ---------- About ---------- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
  }
  .about-text {
    max-width: 710px;
  }
  .about-text p + p {
    margin-top: 1em;
  }
  .side-title {
    font-size: 11px;
    font-weight: 400;
    color: var(--mist);
    margin-bottom: 14px;
  }

  /* ---------- Works ---------- */
  .works-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 8px;
  }

  /* ---------- Skills: レベルの説明 ---------- */
  .legend {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0 0 48px;
  }
  .legend-item {
    padding: 20px 24px;
    background: var(--surface);
  }
  .legend-item dd {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }
  .lv {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }
  .lv-dots {
    display: inline-flex;
    gap: 3px;
  }
  .dot {
    width: 9px;
    height: 9px;
    border: 1px solid var(--fg);
  }
  .dot.on {
    background: var(--fg);
  }

  /* ---------- History ---------- */
  .timeline {
    list-style: none;
    max-width: 710px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 8em minmax(0, 1fr);
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .timeline time {
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .tl-title {
    letter-spacing: 0.05em;
  }
  .tl-desc {
    font-size: 13px;
    color: var(--muted);
  }


  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    .legend {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
