---
// トップページ。見る順番に合わせて並べている。
//   1. 誰か (名前・所属・学年) → 2. 作品 (主役) → 3. スキル (比べる) → 4. プロフィール・経歴 (補足)
// データが空の項目は、見出しごと出さない。
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import WorkTile from '../components/WorkTile.astro';
import Footer from '../components/Footer.astro';
import SkillList from '../components/SkillList.astro';
import { site, profile, works, levels, timeline } from '../data/profile';

const levelKeys = Object.keys(levels).map(Number) as (keyof typeof levels)[];
const filled = (s?: string) => typeof s === 'string' && s.trim() !== '';

const about = profile.about.filter(filled);
const interests = [...new Set(profile.interests.filter(filled))];
const events = timeline.filter((e) => filled(e.title));
const affiliation = [profile.school, profile.grade].filter(filled).join(' ');
---

<Base
  title={`${profile.nameEn} | ${site.title}`}
  description={`${affiliation} のポートフォリオ`}
>
  <Header />

  <main id="top">
    <!-- 誰か: 名前・所属・学年 -->
    <section class="intro container" aria-label="自己紹介">
      <h1 class="intro-name">{profile.name}</h1>
      {filled(affiliation) && <p class="intro-aff">{affiliation}</p>}
      {filled(profile.tagline) && <p class="intro-tagline">{profile.tagline}</p>}
    </section>

    <!-- 作品: ページの主役 -->
    <section class="section" id="works" aria-labelledby="works-title">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title" id="works-title">作品</h2>
          {works.length > 0 && <p class="section-count">{works.length}件</p>}
        </div>
        {
          works.length > 0 ? (
            <ul class="works-grid">
              {works.map((w) => (
                <li>
                  <WorkTile work={w} />
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">作品はまだありません。</p>
          )
        }
      </div>
    </section>

    <!-- スキル: レベルで比べる -->
    <section class="section" id="skills" aria-labelledby="skills-title">
      <div class="container">
        <div class="section-head">
          <h2 class="section-title" id="skills-title">スキル</h2>
        </div>

        <dl class="legend" aria-label="レベルの意味">
          {
            levelKeys.map((k) => (
              <div class="legend-row">
                <dt>
                  <span class="lv-dots" aria-hidden="true">
                    {[1, 2, 3].map((d) => (
                      <span class:list={['dot', { on: d <= k }]} />
                    ))}
                  </span>
                  Lv.{k} {levels[k].name}
                </dt>
                <dd>{levels[k].desc}</dd>
              </div>
            ))
          }
        </dl>

        <SkillList />
      </div>
    </section>

    <!-- プロフィール: 補足 -->
    {
      (about.length > 0 || interests.length > 0) && (
        <section class="section" id="about" aria-labelledby="about-title">
          <div class="container">
            <div class="section-head">
              <h2 class="section-title" id="about-title">プロフィール</h2>
            </div>
            <div class="about">
              {about.length > 0 && (
                <div class="about-text">
                  {about.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              )}
              {interests.length > 0 && (
                <div>
                  <h3 class="side-title">興味・得意なこと</h3>
                  <ul class="tags">
                    {interests.map((t) => (
                      <li class="tag">{t}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </section>
      )
    }

    <!-- 経歴: 補足 -->
    {
      events.length > 0 && (
        <section class="section" id="history" aria-labelledby="history-title">
          <div class="container">
            <div class="section-head">
              <h2 class="section-title" id="history-title">経歴</h2>
            </div>
            <ol class="timeline">
              {events.map((e) => (
                <li>
                  <time>{filled(e.date) ? e.date : '時期不明'}</time>
                  <div>
                    <p class="tl-title">{e.title}</p>
                    {filled(e.desc) && <p class="tl-desc">{e.desc}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Base>

<style>
  /* ---------- 自己紹介: 画面を占領せず、すぐ下に作品が見える高さにする ---------- */
  .intro {
    padding-block: clamp(48px, 9vw, 104px) clamp(40px, 6vw, 72px);
  }
  .intro-name {
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .intro-aff {
    margin-top: 16px;
    font-size: 18px;
    color: var(--fg);
  }
  .intro-tagline {
    margin-top: 8px;
    max-width: 40em;
    font-size: 16px;
    color: var(--muted);
  }

  /* ---------- 作品 ---------- */
  .works-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 8px;
  }
  .empty {
    color: var(--muted);
  }

  /* ---------- スキル: レベルの意味 (表のように1行ずつ) ---------- */
  .legend {
    margin: 0 0 40px;
    max-width: 760px;
  }
  .legend-row {
    display: grid;
    grid-template-columns: 15em minmax(0, 1fr);
    gap: 4px 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 14px;
  }
  .legend-row:first-child {
    border-top: 1px solid var(--line-soft);
  }
  .legend dt {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    white-space: nowrap;
  }
  .legend dd {
    margin: 0;
    color: var(--muted);
  }
  .lv-dots {
    display: inline-flex;
    gap: 3px;
  }
  .dot {
    width: 9px;
    height: 9px;
    border: 1px solid var(--fg);
  }
  .dot.on {
    background: var(--fg);
  }

  /* ---------- プロフィール ---------- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 64px);
  }
  .about-text {
    max-width: 40em;
  }
  .about-text p + p {
    margin-top: 1em;
  }
  .side-title {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  /* ---------- 経歴 ---------- */
  .timeline {
    list-style: none;
    max-width: 760px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 7em minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .timeline li:first-child {
    border-top: 1px solid var(--line-soft);
  }
  .timeline time {
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .tl-desc {
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .legend-row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
