---
// 作品の詳細ページ。profile.ts の works 1件ごとに /works/<id>/ を生成する。
// このページで目立たせる行動は作品のリンクだけなので、一覧へ戻る・前後の作品は文字のリンクにする。
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WorkCard from '../../components/WorkCard.astro';
import Lightbox from '../../components/Lightbox.astro';
import { profile, site, works, type Work } from '../../data/profile';
import { asset } from '../../lib/url';

export function getStaticPaths() {
  return works.map((work, index) => ({ params: { id: work.id }, props: { work, index } }));
}

interface Props {
  work: Work;
  index: number;
}
const { work, index } = Astro.props;
const prev = works[index - 1];
const next = works[index + 1];
const list = `${asset('')}#works`;
---

<Base title={`${work.title} | ${profile.nameEn} ${site.title}`} description={work.short}>
  <Header />

  <main class="container">
    <nav class="crumb" aria-label="パンくずリスト">
      <a href={list}>作品一覧</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{work.title}</span>
    </nav>

    <WorkCard work={work} />

    <nav class="pager" aria-label="ほかの作品">
      {
        prev ? (
          <a class="pager-link" href={asset(`works/${prev.id}/`)}>
            <span class="pager-dir">前の作品</span>
            <span class="pager-title">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="pager-link pager-next" href={asset(`works/${next.id}/`)}>
            <span class="pager-dir">次の作品</span>
            <span class="pager-title">{next.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </main>

  <Footer />
  <Lightbox />
</Base>

<style>
  .crumb {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding-top: clamp(24px, 5vw, 48px);
    font-size: 14px;
    color: var(--muted);
  }
  .crumb [aria-current] {
    overflow-wrap: anywhere;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-block: 24px clamp(56px, 9vw, 96px);
    border-top: 1px solid var(--line-soft);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 0;
    text-decoration: none;
  }
  .pager-next {
    text-align: right;
  }
  .pager-dir {
    font-size: 13px;
    color: var(--muted);
  }
  .pager-title {
    font-size: 16px;
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .pager-link:hover .pager-title {
    color: var(--fg);
  }
</style>
