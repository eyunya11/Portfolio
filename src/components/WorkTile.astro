---
// 作品一覧のカード。クリックすると作品の詳細ページへ移動する。
import type { Work } from '../data/profile';
import { asset } from '../lib/url';
import TechTags from './TechTags.astro';

interface Props {
  work: Work;
  index: number;
}
const { work, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<a class="tile" href={asset(`works/${work.id}/`)}>
  <p class="tile-label en">
    <span class="num">{num}</span>
    {work.label}
  </p>
  <h3 class="tile-title">{work.title}</h3>
  <p class="tile-short">{work.short}</p>
  <div class="tile-tech">
    <TechTags items={work.tech.slice(0, 4)} size="small" />
  </div>
  <span class="tile-more en">View <span aria-hidden="true">→</span></span>
</a>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 32px;
    background: var(--surface);
    color: var(--fg);
    text-decoration: none;
    transition: background 0.2s;
  }
  .tile:hover {
    background: var(--surface-2);
    color: var(--fg);
  }
  .tile-label {
    font-size: 11px;
    color: var(--muted);
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .num {
    color: var(--mist);
  }
  .tile-title {
    font-size: clamp(20px, 2vw, 22px);
    font-weight: 700;
    line-height: 1.4;
    margin-top: 16px;
    overflow-wrap: break-word;
  }
  .tile-short {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
    margin-top: 10px;
  }
  .tile-tech {
    margin-top: 16px;
  }
  .tile-more {
    margin-top: auto;
    padding-top: 24px;
    font-size: 12px;
    color: var(--link);
  }
  .tile:hover .tile-more {
    text-decoration: underline;
  }
</style>
