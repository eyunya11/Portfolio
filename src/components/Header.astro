---
import { profile, timeline } from '../data/profile';
import { asset } from '../lib/url';

// 作品の詳細ページからでもトップの各セクションへ移動できるよう、base 付きのパスにする
const home = asset('');
const filled = (s?: string) => typeof s === 'string' && s.trim() !== '';

// トップでは中身が空のセクションを出さないので、メニューも同じ条件で出し分ける (リンク切れを防ぐ)
const hasAbout = profile.about.some(filled) || profile.interests.some(filled);
const hasHistory = timeline.some((e) => filled(e.title));

const nav = [
  { href: `${home}#works`, label: '作品', show: true },
  { href: `${home}#skills`, label: 'スキル', show: true },
  { href: `${home}#about`, label: 'プロフィール', show: hasAbout },
  { href: `${home}#history`, label: '経歴', show: hasHistory },
].filter((n) => n.show);
---

<header class="header">
  <div class="container header-inner">
    <a class="logo" href={home}>{profile.nameEn}</a>

    <nav class="nav-pc" aria-label="ページ内メニュー">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu">メニュー</button>
  </div>

  <!-- スマホ用: 全画面の黒いメニュー -->
  <div class="menu" id="menu" hidden>
    <button class="menu-close" type="button">閉じる</button>
    <nav aria-label="ページ内メニュー (スマホ)">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.querySelector<HTMLDivElement>('#menu');
  const close = document.querySelector<HTMLButtonElement>('.menu-close');

  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--header-h);
    /* backdrop-filter を付けると、中の全画面メニュー (position: fixed) が
       ヘッダーの高さに閉じ込められるため、不透明な背景にしている */
    background: var(--bg);
    border-bottom: 1px solid var(--line-soft);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .logo {
    font-size: 16px;
    font-weight: 400;
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-pc ul {
    display: flex;
    gap: 32px;
    list-style: none;
  }
  .nav-pc a {
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
  }
  .nav-pc a:hover {
    color: var(--fg);
  }
  .menu-btn,
  .menu-close {
    font: inherit;
    font-size: 14px;
    min-height: 44px;
    padding: 0 0 0 16px;
    background: none;
    border: none;
    color: var(--fg);
    cursor: pointer;
  }
  .menu-btn {
    display: none;
  }
  .menu {
    position: fixed;
    inset: 0;
    z-index: 20;
    background: var(--bg);
    padding: 12px var(--gutter);
    display: flex;
    flex-direction: column;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-close {
    align-self: flex-end;
  }
  .menu ul {
    list-style: none;
    margin-top: 32px;
    border-top: 1px solid var(--line-soft);
  }
  .menu a {
    display: block;
    font-size: 20px;
    font-weight: 400;
    color: var(--fg);
    text-decoration: none;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  @media (max-width: 768px) {
    .nav-pc {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
</style>
