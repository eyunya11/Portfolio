---
import { profile } from '../data/profile';
import { asset } from '../lib/url';

// 作品の詳細ページからでもトップの各セクションへ移動できるよう、base 付きのパスにする
const home = asset('');

const nav = [
  { href: `${home}#about`, label: 'About' },
  { href: `${home}#works`, label: 'Works' },
  { href: `${home}#skills`, label: 'Skills' },
  { href: `${home}#history`, label: 'History' },
  { href: `${home}#contact`, label: 'Contact' },
];
---

<header class="header">
  <div class="container header-inner">
    <a class="logo en" href={home}>{profile.nameEn}</a>

    <nav class="nav-pc" aria-label="ページ内メニュー">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <button class="menu-btn en" type="button" aria-expanded="false" aria-controls="menu">Menu</button>
  </div>

  <!-- スマホ用: 全画面の黒いメニュー -->
  <div class="menu" id="menu" hidden>
    <button class="menu-close en" type="button">Close</button>
    <nav aria-label="ページ内メニュー (スマホ)">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.querySelector<HTMLDivElement>('#menu');
  const close = document.querySelector<HTMLButtonElement>('.menu-close');

  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    height: var(--header-h);
    background: var(--white);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .logo {
    font-size: 16px;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-pc ul {
    display: flex;
    gap: 28px;
    list-style: none;
  }
  .nav-pc a {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
  }
  .nav-pc a:hover {
    text-decoration: underline;
  }

  .menu-btn,
  .menu-close {
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 0 8px 16px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .menu-btn {
    display: none;
    color: var(--black);
  }
  .menu {
    position: fixed;
    inset: 0;
    z-index: 20;
    background: var(--black);
    color: var(--white);
    padding: 12px var(--gutter);
    display: flex;
    flex-direction: column;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-close {
    align-self: flex-end;
    color: var(--white);
  }
  .menu ul {
    list-style: none;
    margin-top: 40px;
  }
  .menu a {
    display: block;
    font-size: 28px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    padding: 8px 0;
    color: var(--white);
  }
  .menu a:hover {
    text-decoration: underline;
  }
  .menu :focus-visible {
    outline-color: var(--white);
  }

  @media (max-width: 720px) {
    .nav-pc {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
</style>
