<dialog class="lightbox" aria-label="画像の拡大表示">
  <form method="dialog" class="lb-close-form">
    <button class="lb-close en" aria-label="閉じる">Close</button>
  </form>
  <img class="lb-img" alt="" />
  <p class="lb-caption"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const img = dialog?.querySelector<HTMLImageElement>('.lb-img');
  const caption = dialog?.querySelector<HTMLParagraphElement>('.lb-caption');

  document.querySelectorAll<HTMLButtonElement>('.shot').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!dialog || !img || !caption) return;
      img.src = btn.dataset.full ?? '';
      img.alt = btn.querySelector('img')?.alt ?? '';
      caption.textContent = btn.dataset.caption ?? '';
      dialog.showModal();
    });
  });

  // 画像の外側(背景)をクリックしたら閉じる
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .lightbox {
    width: min(1200px, 94vw);
    max-height: 92vh;
    padding: 16px;
    border: 1px solid var(--line-soft);
    border-radius: 2px;
    background: var(--bg);
    color: var(--fg);
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }
  .lb-close-form {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 12px;
  }
  .lb-close {
    font: inherit;
    font-size: 12px;
    min-height: 44px;
    padding: 0 20px;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 2px;
    cursor: pointer;
  }
  .lb-close:hover {
    background: var(--surface-2);
  }
  .lb-img {
    width: 100%;
    max-height: 74vh;
    object-fit: contain;
  }
  .lb-caption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
