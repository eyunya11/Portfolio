---
import { profile, links, site } from '../data/profile';
import { asset } from '../lib/url';

const shown = links.filter((l) => l.url.trim() !== '');
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="meta">
      © 2026 {profile.nameEn}
      <span>最終更新 <time datetime={site.updated}>{site.updated}</time></span>
    </p>
    {
      shown.length > 0 && (
        <ul class="social">
          {shown.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer" aria-label={`${l.label} (新しいタブで開く)`}>
                <img src={asset(`icons/${l.icon}.svg`)} alt="" width="32" height="32" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .footer {
    background: #000000;
    color: var(--muted);
    border-top: 1px solid var(--line-soft);
    padding-block: 24px 40px;
    font-size: 13px;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  .social {
    list-style: none;
    display: flex;
    gap: 8px;
  }
  /* 指で押しやすいよう、押せる範囲は 44px 四方にする */
  .social a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 2px;
  }
  .social a:hover {
    background: var(--surface-2);
  }
  .social img {
    width: 32px;
    height: 32px;
  }
</style>
