---
// スキル一覧。アイコン・名前・レベルだけのタイルを並べる (クリックでは開かない)。
// レベルの意味は、すぐ上の凡例 (index.astro の .legend) で説明している。
import { skillGroups, levels } from '../data/profile';
import { asset } from '../lib/url';

// アイコンがないスキルは、名前の頭2文字を白い四角に入れて代わりにする
const initials = (name: string) => name.replace(/[^A-Za-z]/g, '').slice(0, 2) || name.slice(0, 1);
---

{
  skillGroups.map((g) => (
    <div class="skill-group">
      <h3 class="skill-group-title">{g.title}</h3>
      <ul class="skills">
        {g.items.map((s) => (
          <li class="skill">
            <span class="skill-icons" aria-hidden="true">
              {s.icons && s.icons.length > 0 ? (
                s.icons.map((ic) => <img src={asset(`icons/${ic}.svg`)} alt="" width="40" height="40" />)
              ) : (
                <span class="no-icon">{initials(s.name)}</span>
              )}
            </span>
            <span class="skill-name">{s.name}</span>
            <span class="lv" aria-label={`レベル ${s.level}: ${levels[s.level].name}`}>
              <span class="lv-dots" aria-hidden="true">
                {[1, 2, 3].map((d) => (
                  <span class:list={['dot', { on: d <= s.level }]} />
                ))}
              </span>
              <span aria-hidden="true">Lv.{s.level}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  ))
}

<style>
  .skill-group + .skill-group {
    margin-top: 48px;
  }
  .skill-group-title {
    font-size: 16px;
    letter-spacing: 0.1em;
    font-feature-settings: 'palt';
    margin-bottom: 16px;
  }
  .skills {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: 8px;
  }

  .skill {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    background: var(--surface);
  }
  .skill-icons {
    display: flex;
    gap: 6px;
  }
  .skill-icons img {
    width: 40px;
    height: 40px;
  }
  .no-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 3px;
    background: #ffffff;
    color: #000000;
    font-size: 15px;
    font-weight: 700;
  }
  .skill-name {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .lv {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
  }
  .lv-dots {
    display: inline-flex;
    gap: 3px;
  }
  .dot {
    width: 9px;
    height: 9px;
    border: 1px solid var(--fg);
  }
  .dot.on {
    background: var(--fg);
  }

  /* スマホ: 2列 */
  @media (max-width: 520px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .skill {
      padding: 14px;
    }
    .skill-icons {
      gap: 4px;
    }
    .skill-icons img,
    .no-icon {
      width: 32px;
      height: 32px;
    }
  }
</style>
