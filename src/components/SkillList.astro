---
// スキル一覧。普段はアイコンと名前だけのタイルを並べ、クリックすると Lv・経験・説明を開く。
// <details> を使っているので JavaScript がなくても開閉できる。
import { skillGroups, levels } from '../data/profile';
import { asset } from '../lib/url';

// アイコンがないスキルは、名前の頭2文字を黒い四角に入れて代わりにする
const initials = (name: string) => name.replace(/[^A-Za-z]/g, '').slice(0, 2) || name.slice(0, 1);
---

<div class="skill-tools">
  <button type="button" class="toggle-all en" aria-pressed="false">すべて開く</button>
</div>

{
  skillGroups.map((g) => (
    <div class="skill-group">
      <h3 class="skill-group-title">{g.title}</h3>
      <ul class="skills">
        {g.items.map((s) => (
          <li>
            <details class="skill">
              <summary>
                <span class="skill-icons" aria-hidden="true">
                  {s.icons && s.icons.length > 0 ? (
                    s.icons.map((ic) => <img src={asset(`icons/${ic}.svg`)} alt="" width="40" height="40" />)
                  ) : (
                    <span class="no-icon">{initials(s.name)}</span>
                  )}
                </span>
                <span class="skill-name">{s.name}</span>
                <span class="lv" aria-label={`レベル ${s.level}: ${levels[s.level].name}`}>
                  <span class="lv-dots" aria-hidden="true">
                    {[1, 2, 3].map((d) => (
                      <span class:list={['dot', { on: d <= s.level }]} />
                    ))}
                  </span>
                  <span aria-hidden="true">Lv.{s.level}</span>
                </span>
                <span class="plus" aria-hidden="true" />
              </summary>
              <div class="skill-body">
                <p class="skill-lv">Lv.{s.level} {levels[s.level].name}</p>
                <p class="skill-period">経験: {s.period}</p>
                <p class="skill-desc">{s.desc}</p>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  ))
}

<script>
  const btn = document.querySelector<HTMLButtonElement>('.toggle-all');
  const all = () => [...document.querySelectorAll<HTMLDetailsElement>('details.skill')];

  const sync = () => {
    if (!btn) return;
    const open = all().every((d) => d.open);
    btn.textContent = open ? 'すべて閉じる' : 'すべて開く';
    btn.setAttribute('aria-pressed', String(open));
  };

  btn?.addEventListener('click', () => {
    const open = !all().every((d) => d.open);
    all().forEach((d) => (d.open = open));
    sync();
  });
  all().forEach((d) => d.addEventListener('toggle', sync));
</script>

<style>
  .skill-tools {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 8px;
  }
  .toggle-all {
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 16px 6px;
    color: var(--black);
    background: var(--white);
    border: 1px solid var(--black);
    cursor: pointer;
  }
  .toggle-all:hover,
  .toggle-all[aria-pressed='true'] {
    color: var(--white);
    background: var(--black);
  }

  .skill-group + .skill-group {
    margin-top: 48px;
  }
  .skill-group-title {
    font-size: 18px;
    margin-bottom: 12px;
  }
  .skills {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: 8px;
    align-items: start;
  }

  .skill {
    border: 1px solid var(--black);
    background: var(--white);
  }
  summary {
    list-style: none;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'icon icon plus'
      'name name name'
      'lv lv lv';
    gap: 10px 8px;
    padding: 16px;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .skill-name {
    text-decoration: underline;
  }
  .skill[open] summary {
    background: var(--black);
    color: var(--white);
  }
  .skill[open] .dot {
    border-color: var(--white);
  }
  .skill[open] .dot.on {
    background: var(--white);
  }
  .skill[open] .no-icon {
    background: var(--white);
    color: var(--black);
  }
  .skill[open] summary:focus-visible {
    outline-color: var(--accent);
  }

  .skill-icons {
    grid-area: icon;
    display: flex;
    gap: 6px;
  }
  .skill-icons img {
    width: 40px;
    height: 40px;
  }
  .no-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: var(--black);
    color: var(--white);
    font-size: 15px;
    font-weight: 700;
  }
  .skill-name {
    grid-area: name;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .lv {
    grid-area: lv;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
  }
  .lv-dots {
    display: inline-flex;
    gap: 3px;
  }
  .dot {
    width: 9px;
    height: 9px;
    border: 1px solid var(--black);
  }
  .dot.on {
    background: var(--black);
  }

  /* 開閉の印 (+ / −) */
  .plus {
    grid-area: plus;
    position: relative;
    width: 14px;
    height: 14px;
    align-self: start;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    background: currentColor;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  .skill[open] .plus::after {
    display: none;
  }

  .skill-body {
    padding: 14px 16px 18px;
  }

  /* スマホ: 2列にし、開いたタイルだけ横幅いっぱいに広げる */
  @media (max-width: 520px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .skills li:has(details[open]) {
      grid-column: 1 / -1;
    }
    summary {
      padding: 12px;
    }
    .skill-icons {
      gap: 4px;
    }
    .skill-icons img,
    .no-icon {
      width: 32px;
      height: 32px;
    }
  }
  .skill-lv {
    font-size: 12px;
    font-weight: 700;
  }
  .skill-period {
    font-size: 12px;
    color: var(--ink);
  }
  .skill-desc {
    font-size: 14px;
    line-height: 1.75;
    margin-top: 8px;
  }
</style>
